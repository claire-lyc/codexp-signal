POSTGRES_DB=signal
POSTGRES_USER=signal_app
POSTGRES_PASSWORD=signal_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://signal_app:signal_dev_password@localhost:5432/signal
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=30d
JWT_REFRESH_DAYS=7
DEMO_ADMIN_EMAIL=admin@signal.local
DEMO_ADMIN_PASSWORD=replace-with-temp-admin-password

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_SEVERITY_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_SEVERITY_MODEL=openai/gpt-4.1-mini
OPENROUTER_SEVERITY_MAX_TOKENS=50
OPENROUTER_MISINFORMATION_MODEL=openai/gpt-4.1-mini
OPENROUTER_MISINFORMATION_MAX_TOKENS=50
OPENROUTER_SITE_URL=http://localhost:4000
OPENROUTER_APP_NAME=SiGnal
# For Neon, replace DATABASE_URL with the connection string from Neon's Connect modal.
# Prefer the pooled connection string for serverless deployments.
# Example shape:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
